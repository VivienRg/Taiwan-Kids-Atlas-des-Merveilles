# Taiwan Kids Atlas — mobile environment (development).
#
# Copy to `.env` (git-ignored) and fill in. Only EXPO_PUBLIC_* values reach the
# bundle: they are inlined at build time, so they must never hold a secret that
# the client should not see. The anon (publishable) Supabase key is public by
# design; the service_role key, the DB password and INGEST_CRON_SECRET must
# never appear here (docs/secrets.md §4).
#
# For EAS builds these come from EAS environment variables per profile, not from
# this file (docs/release.md §4).

# real | mock — `mock` serves the fixtures in src/api/__fixtures__ (no network).
EXPO_PUBLIC_API_MODE=real

# PostgREST base URL.
#   Supabase CLI (simulator): http://127.0.0.1:54321/rest/v1
#   Android emulator:         http://10.0.2.2:54321/rest/v1
#   Production:               https://<project-ref>.supabase.co/rest/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:54321/rest/v1

# Publishable (anon) key from `supabase status` or the dashboard → Settings → API.
EXPO_PUBLIC_API_ANON_KEY=

# Informational: which profile produced this build (see app.config.ts).
EXPO_PUBLIC_APP_ENV=development

# Android map tiles. Required for the Map tab on Android; iOS uses Apple Maps
# and needs no key. Restricted to the app's package name + SHA-1, and injected
# into the build by app.config.ts.
GOOGLE_MAPS_ANDROID_API_KEY=
