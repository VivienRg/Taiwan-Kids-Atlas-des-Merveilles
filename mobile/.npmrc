# Upstream peer-range lag, not a project problem:
#   eslint-plugin-import@2.32 (and the copy pulled in by eslint-config-expo@8)
#   declares peer eslint "^2 || … || ^9", while this project uses eslint 10 —
#   eslint 10's flat config is what eslint.config.js is written against and
#   `npm run lint` passes with it.
# Without this, `npm ci` aborts with ERESOLVE and the mobile CI job cannot even
# install. Revisit when eslint-plugin-import declares eslint 10 support; then drop
# this file and re-run `npm install`.
legacy-peer-deps=true
