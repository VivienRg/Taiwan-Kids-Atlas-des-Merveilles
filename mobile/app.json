{
  "expo": {
    "name": "Taiwan Kids Atlas",
    "slug": "kidsatlas",
    "version": "1.0.0",
    "scheme": "kidsatlas",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F9FC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taiwankidsatlas.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F9FC"
      },
      "package": "com.taiwankidsatlas.app",
      "googleMaps": {
        "apiKey": ""
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["react-native-maps", { "androidGoogleMapsApiKey": "" }]
    ]
  }
}
