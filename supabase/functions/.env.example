# Taiwan Kids Atlas — ingestion worker environment (backend card)
# Copy to .env (git-ignored) and fill in. Never commit real values.
#
# Local dev against docker Postgres (see docker-compose.yml):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:54330/atlas_dev
# Local dev against the Supabase CLI stack:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:54330/atlas_dev

# Shared secret for the ingest Edge Function (pg_cron → pg_net → Edge Function).
# Must match Vault secret ingest_cron_secret in prod. Any dev string locally.
INGEST_CRON_SECRET=dev-secret-change-me

# Hard deadline between batches (ms). CLI default 600 000; Edge default 120 000.
INGEST_DEADLINE_MS=600000

# User-Agent sent with every feed request.
INGEST_USER_AGENT=TaiwanKidsAtlas-Ingest/1.0.0 (+https://github.com/VivienRg/Taiwan-Kids-Atlas-des-Merveilles)

# Log level: debug | info | warn | error
INGEST_LOG_LEVEL=debug

# Reserved for TDX (not used in v1 — see docs/data-sources.md §5).
# TDX_CLIENT_ID=
# TDX_CLIENT_SECRET=
