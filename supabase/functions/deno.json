{
  "tasks": {
    "ingest": "deno run --allow-net --allow-env --allow-read --allow-sys --allow-run=curl _shared/ingest/cli.ts",
    "test": "deno run --no-check --allow-all _shared/ingest/__tests__/run_all.ts",
    "typecheck": "deno check ingest/index.ts _shared/ingest/cli.ts _shared/ingest/__tests__/run_all.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno task lint && deno task typecheck && deno task test"
  },
  "fmt": {
    "options": {
      "singleQuote": true,
      "lineWidth": 100
    }
  },
  "imports": {
    "std/": "https://deno.land/std@0.224.0/"
  },
  "exclude": [
    "_shared/ingest/vendor"
  ],
  "lock": false
}
